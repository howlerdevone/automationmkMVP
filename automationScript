function buildConfig(router) {
  // --- Derive values from lan_ip ---
  const rawIp = router.lan_ip.toString().split("/")[0].trim();
  const ipParts = rawIp.split(".");
  const networkBase = ipParts.slice(0, 3).join(".");

  const lan_ip = rawIp + "/24";
  const lan_network = networkBase + ".0/24";
  const dhcp_range = networkBase + ".100-" + networkBase + ".200";
  const dns = "8.8.8.8,1.1.1.1";

  return `
# ============================================================
# AUTO PROVISION CONFIG
# Router : ${router.router_name}
# Generated by Credicentrales Provisioning System
# ============================================================

:log info "AutoProvision: Starting configuration for ${router.router_name}";

# --- Wait for ethernet interfaces ---
:local count 0;
:while ([/interface ethernet find] = "") do={
  :if ($count = 30) do={
    :log warning "AutoProvision: Unable to find ethernet interfaces";
    /quit;
  }
  :delay 1s; :set count ($count + 1);
};
:log info "AutoProvision: Ethernet interfaces found";

# --- System Identity ---
/system identity set name="${router.router_name}"

# --- Interface Lists ---
/interface list add name=WAN comment="autoprovision"
/interface list add name=LAN comment="autoprovision"

# --- LAN Bridge (defconf pattern) ---
/interface bridge add name=bridge disabled=no auto-mac=yes protocol-mode=rstp comment="autoprovision"

:local bMACIsSet 0;
:foreach k in=[/interface find where !(slave=yes || name="ether1" || passthrough=yes || name~"bridge")] do={
  :local tmpPortName [/interface get $k name];
  :if ($bMACIsSet = 0) do={
    :if ([/interface get $k type] = "ether") do={
      /interface bridge set "bridge" auto-mac=no admin-mac=[/interface get $tmpPortName mac-address];
      :set bMACIsSet 1;
    }
  }
  :if (([/interface get $k type] != "ppp-out") && ([/interface get $k type] != "lte")) do={
    /interface bridge port add bridge=bridge interface=$tmpPortName comment="autoprovision";
    :log info "AutoProvision: Added $tmpPortName to bridge";
  }
}

# --- WAN DHCP Client ---
/ip dhcp-client add interface=ether1 disabled=no comment="autoprovision"

# --- Interface List Members ---
/interface list member add list=LAN interface=bridge comment="autoprovision"
/interface list member add list=WAN interface=ether1 comment="autoprovision"

# --- LAN IP Address ---
/ip address add address=${lan_ip} interface=bridge comment="autoprovision"

# --- DNS ---
/ip dns set servers=${dns} allow-remote-requests=yes
/ip dns static add name=router.lan address=${rawIp} comment="autoprovision"

# --- DHCP Server ---
/ip pool add name="dhcp-pool" ranges=${dhcp_range} comment="autoprovision"
/ip dhcp-server add name=dhcp1 address-pool="dhcp-pool" interface=bridge lease-time=10m disabled=no comment="autoprovision"
/ip dhcp-server network add address=${lan_network} gateway=${rawIp} dns-server=${rawIp} comment="autoprovision"

# --- IPv4 Firewall (defconf) ---
/ip firewall nat add chain=srcnat out-interface-list=WAN ipsec-policy=out,none action=masquerade comment="autoprovision: masquerade"

/ip firewall filter
add chain=input   action=accept               connection-state=established,related,untracked   comment="autoprovision: accept established,related,untracked"
add chain=input   action=drop                 connection-state=invalid                         comment="autoprovision: drop invalid"
add chain=input   action=accept               protocol=icmp                                    comment="autoprovision: accept ICMP"
add chain=input   action=accept               dst-address=127.0.0.1                            comment="autoprovision: accept to local loopback (for CAPsMAN)"
add chain=input   action=drop                 in-interface-list=!LAN                           comment="autoprovision: drop all not coming from LAN"
add chain=forward action=accept               ipsec-policy=in,ipsec                            comment="autoprovision: accept in ipsec policy"
add chain=forward action=accept               ipsec-policy=out,ipsec                           comment="autoprovision: accept out ipsec policy"
add chain=forward action=fasttrack-connection connection-state=established,related             comment="autoprovision: fasttrack"
add chain=forward action=accept               connection-state=established,related,untracked   comment="autoprovision: accept established,related,untracked"
add chain=forward action=drop                 connection-state=invalid                         comment="autoprovision: drop invalid"
add chain=forward action=drop                 connection-state=new connection-nat-state=!dstnat in-interface-list=WAN comment="autoprovision: drop all from WAN not DSTNATed"

# --- IPv6 Firewall (defconf) ---
/ipv6 firewall address-list
add list=bad_ipv6 address=::/128             comment="autoprovision: unspecified address"
add list=bad_ipv6 address=::1               comment="autoprovision: lo"
add list=bad_ipv6 address=fec0::/10         comment="autoprovision: site-local"
add list=bad_ipv6 address=::ffff:0:0/96     comment="autoprovision: ipv4-mapped"
add list=bad_ipv6 address=::/96             comment="autoprovision: ipv4 compat"
add list=bad_ipv6 address=100::/64          comment="autoprovision: discard only"
add list=bad_ipv6 address=2001:db8::/32     comment="autoprovision: documentation"
add list=bad_ipv6 address=2001:10::/28      comment="autoprovision: ORCHID"
add list=bad_ipv6 address=3ffe::/16         comment="autoprovision: 6bone"

/ipv6 firewall filter
add chain=input   action=accept               connection-state=established,related,untracked   comment="autoprovision: accept established,related,untracked"
add chain=input   action=drop                 connection-state=invalid                         comment="autoprovision: drop invalid"
add chain=input   action=accept               protocol=icmpv6                                  comment="autoprovision: accept ICMPv6"
add chain=input   action=accept               protocol=udp port=33434-33534                    comment="autoprovision: accept UDP traceroute"
add chain=input   action=accept               protocol=udp dst-port=546 src-address=fe80::/10  comment="autoprovision: accept DHCPv6-Client prefix delegation"
add chain=input   action=accept               protocol=udp dst-port=500,4500                   comment="autoprovision: accept IKE"
add chain=input   action=accept               protocol=ipsec-ah                                comment="autoprovision: accept ipsec AH"
add chain=input   action=accept               protocol=ipsec-esp                               comment="autoprovision: accept ipsec ESP"
add chain=input   action=accept               ipsec-policy=in,ipsec                            comment="autoprovision: accept all that matches ipsec policy"
add chain=input   action=drop                 in-interface-list=!LAN                           comment="autoprovision: drop everything else not coming from LAN"
add chain=forward action=accept               connection-state=established,related,untracked   comment="autoprovision: accept established,related,untracked"
add chain=forward action=drop                 connection-state=invalid                         comment="autoprovision: drop invalid"
add chain=forward action=drop                 src-address-list=bad_ipv6                        comment="autoprovision: drop packets with bad src ipv6"
add chain=forward action=drop                 dst-address-list=bad_ipv6                        comment="autoprovision: drop packets with bad dst ipv6"
add chain=forward action=drop                 protocol=icmpv6 hop-limit=equal:1                comment="autoprovision: rfc4890 drop hop-limit=1"
add chain=forward action=accept               protocol=icmpv6                                  comment="autoprovision: accept ICMPv6"
add chain=forward action=accept               protocol=139                                     comment="autoprovision: accept HIP"
add chain=forward action=accept               protocol=udp dst-port=500,4500                   comment="autoprovision: accept IKE"
add chain=forward action=accept               protocol=ipsec-ah                                comment="autoprovision: accept ipsec AH"
add chain=forward action=accept               protocol=ipsec-esp                               comment="autoprovision: accept ipsec ESP"
add chain=forward action=accept               ipsec-policy=in,ipsec                            comment="autoprovision: accept all that matches ipsec policy"
add chain=forward action=drop                 in-interface-list=!LAN                           comment="autoprovision: drop everything else not coming from LAN"

# --- Neighbor Discovery & MAC Server ---
/ip neighbor discovery-settings set discover-interface-list=LAN
/tool mac-server set allowed-interface-list=LAN
/tool mac-server mac-winbox set allowed-interface-list=LAN

# --- Wireless Configuration ---
:local hasWifi 0;
:local wcount 0;
:while ($wcount < 20) do={
  :if ([/interface wireless print count-only] > 0) do={
    :set hasWifi 1;
    :set wcount 20;
  } else={
    :delay 1s;
    :set wcount ($wcount + 1);
  }
}

:if ($hasWifi = 1) do={
  /interface wireless set [ find default-name=wlan1 ] ssid="${router.ssid}" mode=ap-bridge disabled=no
  /interface wireless security-profiles set [ find default=yes ] authentication-types=wpa2-psk mode=dynamic-keys wpa2-pre-shared-key="${router.wifi_pasword}"
  :log info "AutoProvision: WiFi configured - SSID ${router.ssid}";
} else={
  :log warning "AutoProvision: No wireless interfaces - skipping WiFi config";
}

# --- Admin User ---
/user add name=credicentrales password="$0p0rt3ch" group=full comment="autoprovision"

# --- Disable unused services ---
/ip service disable telnet
/ip service disable ftp
/ip service disable www
/ip service disable api
/ip service set ssh disabled=no

:log info "AutoProvision: Configuration complete for ${router.router_name}";
`;
}
